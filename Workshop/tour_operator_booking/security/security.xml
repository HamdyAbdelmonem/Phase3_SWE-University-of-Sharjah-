<odoo>
    <record id="group_booking_staff" model="res.groups">
        <field name="name">Tour Operator / Booking Staff</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_operations_staff" model="res.groups">
        <field name="name">Tour Operator / Operations Staff</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_tour_manager" model="res.groups">
        <field name="name">Tour Operator / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_booking_staff')), (4, ref('group_operations_staff'))]"/>
    </record>
</odoo>
