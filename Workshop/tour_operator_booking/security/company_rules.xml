<odoo>
    <record id="rule_package_company" model="ir.rule">
        <field name="name">Tour packages in allowed companies</field>
        <field name="model_id" ref="model_tour_operator_package"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_schedule_company" model="ir.rule">
        <field name="name">Tour departures in allowed companies</field>
        <field name="model_id" ref="model_tour_operator_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_booking_company" model="ir.rule">
        <field name="name">Tour bookings in allowed companies</field>
        <field name="model_id" ref="model_tour_operator_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
