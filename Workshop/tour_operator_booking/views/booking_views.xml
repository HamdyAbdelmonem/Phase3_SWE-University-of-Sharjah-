<odoo>
    <record id="view_booking_list" model="ir.ui.view">
        <field name="name">tour.operator.booking.list</field>
        <field name="model">tour.operator.booking</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="package_id"/>
                <field name="schedule_id"/>
                <field name="number_of_guests"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_price"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_booking_search" model="ir.ui.view">
        <field name="name">tour.operator.booking.search</field>
        <field name="model">tour.operator.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="package_id"/>
                <field name="schedule_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="group_package" string="Tour Package" context="{'group_by':'package_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_booking_form" model="ir.ui.view">
        <field name="name">tour.operator.booking.form</field>
        <field name="model">tour.operator.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_availability" type="object" string="Check Availability"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm Booking &amp; Print Voucher"
                            class="oe_highlight" invisible="state != 'draft'"
                            confirm="Confirm this booking and reserve its seats?"
                            groups="tour_operator_booking.group_booking_staff"/>
                    <button name="action_print_voucher" type="object" string="Print Voucher / QR"
                            invisible="state != 'confirmed'"
                            groups="tour_operator_booking.group_booking_staff"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel Booking"
                            invisible="state != 'confirmed'"
                            groups="tour_operator_booking.group_booking_staff"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>

                <sheet>
                    <h1><field name="name"/></h1>

                    <div class="alert alert-info" invisible="state != 'draft'">
                        Drafts do not reserve seats. Availability is checked again when you confirm.
                    </div>
                    <div class="alert alert-warning" invisible="state != 'cancelled'">
                        This booking is cancelled. Its voucher / QR code is invalid and its seats have been released.
                    </div>

                    <group>
                        <group string="Customer and tour">
                            <field name="company_id" groups="base.group_multi_company" readonly="True"/>
                            <field name="customer_id" readonly="state != 'draft'" options="{'no_quick_create': True}"/>
                            <field name="package_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="schedule_id" readonly="state != 'draft'"
                                   domain="[('state','=','published'),('start_datetime','&gt;',context_today().strftime('%Y-%m-%d')),('package_id','=?',package_id)]"
                                   options="{'no_create': True}"/>
                            <field name="booking_source" readonly="state != 'draft'"/>
                        </group>
                        <group string="Guests and price">
                            <field name="number_of_guests" readonly="state != 'draft'"/>
                            <field name="available_seats"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="unit_price" force_save="1"/>
                            <field name="total_price"/>
                        </group>
                    </group>

                    <group string="Confirmation" invisible="state == 'draft'">
                        <field name="confirmed_at"/>
                        <field name="confirmed_by_id"/>
                    </group>

                    <group string="Cancellation" invisible="state != 'cancelled'">
                        <field name="cancellation_reason"/>
                        <field name="cancelled_at"/>
                        <field name="cancelled_by_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bookings" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">tour.operator.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_booking_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tour booking</p>
            <p>Select a customer and a published departure, then enter the guest count.</p>
        </field>
    </record>
</odoo>
