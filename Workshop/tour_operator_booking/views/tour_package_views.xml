<odoo>
    <record id="view_package_list" model="ir.ui.view">
        <field name="name">tour.operator.package.list</field>
        <field name="model">tour.operator.package</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="price_per_guest"/><field name="currency_id" column_invisible="True"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="view_package_form" model="ir.ui.view">
        <field name="name">tour.operator.package.form</field>
        <field name="model">tour.operator.package</field>
        <field name="arch" type="xml">
            <form><sheet>
                <h1><field name="name" placeholder="Evening Desert Safari"/></h1>
                <group><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="True"/><field name="price_per_guest"/></group>
                <field name="description" placeholder="Describe the tour package..."/>
            </sheet></form>
        </field>
    </record>
    <record id="action_packages" model="ir.actions.act_window">
        <field name="name">Tour Packages</field><field name="res_model">tour.operator.package</field><field name="view_mode">list,form</field>
    </record>
</odoo>
