<odoo>

    <!-- NEXUS DASHBOARD -->

    <record id="action_tour_operator_dashboard"
            model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">tour_operator_dashboard</field>
    </record>


    <!-- NEXUS BOOKING REPORTS -->

    <record id="action_booking_reports_dashboard"
            model="ir.actions.client">
        <field name="name">Booking Reports</field>
        <field name="tag">tour_operator_booking.booking_reports</field>
        <field name="target">current</field>
    </record>


    <!-- NEXUS TOUR SCHEDULING -->

    <record id="action_tour_scheduling_dashboard"
            model="ir.actions.client">
        <field name="name">Tour Scheduling</field>
        <field name="tag">tour_operator_booking.tour_scheduling</field>
        <field name="target">current</field>
    </record>


    <!-- NEXUS CREATE BOOKING -->

    <record id="action_create_booking_dashboard"
            model="ir.actions.client">
        <field name="name">Create Booking</field>
        <field name="tag">tour_operator_booking.create_booking</field>
        <field name="target">current</field>
    </record>

        <!-- NEXUS RESOURCE MANAGEMENT -->

    <record id="action_resource_management_dashboard"
            model="ir.actions.client">
        <field name="name">Drivers and Vehicles</field>
        <field name="tag">tour_operator_booking.resource_management</field>
        <field name="target">current</field>
    </record>

        <!-- NEXUS TOUR PACKAGES -->

    <record id="action_tour_packages_dashboard"
            model="ir.actions.client">
        <field name="name">Tours &amp; Packages</field>
        <field name="tag">tour_operator_booking.tour_packages</field>
        <field name="target">current</field>
    </record>

    <!-- MAIN APPLICATION -->

    <menuitem id="menu_tour_root"
              name="Tour Operator"
              sequence="20"
              groups="tour_operator_booking.group_booking_staff,tour_operator_booking.group_operations_staff"/>


    <!-- DASHBOARD -->

    <menuitem id="menu_dashboard"
              name="Dashboard"
              parent="menu_tour_root"
              action="action_tour_operator_dashboard"
              groups="tour_operator_booking.group_tour_manager"
              sequence="1"/>


    <!-- BOOKINGS -->

    <menuitem id="menu_bookings"
              name="Bookings"
              parent="menu_tour_root"
              groups="tour_operator_booking.group_booking_staff"
              action="action_bookings"
              sequence="10"/>


    <!-- PROFESSIONAL CREATE BOOKING -->

    <menuitem id="menu_create_booking"
              name="Create Booking"
              parent="menu_tour_root"
              action="action_create_booking_dashboard"
              groups="tour_operator_booking.group_booking_staff"
              sequence="11"/>


    <!-- PROFESSIONAL OPERATIONS WORKSPACE -->

    <menuitem id="menu_tour_scheduling"
              name="Operations"
              parent="menu_tour_root"
              action="action_tour_scheduling_dashboard"
              groups="tour_operator_booking.group_operations_staff"
              sequence="15"/>


    <!-- TOUR SETUP -->

    <menuitem id="menu_setup"
              name="Tour Setup"
              parent="menu_tour_root"
              sequence="20"
              groups="tour_operator_booking.group_operations_staff"/>


        <!-- PROFESSIONAL TOUR PACKAGES -->

    <menuitem id="menu_packages"
              name="Tour Packages"
              parent="menu_setup"
              action="action_tour_packages_dashboard"
              sequence="10"/>


    <!-- ORIGINAL TOUR DEPARTURES -->

    <menuitem id="menu_schedules"
              name="Tour Departures"
              parent="menu_setup"
              action="action_schedules"
              sequence="20"/>


        <!-- PROFESSIONAL RESOURCE MANAGEMENT -->

    <menuitem id="menu_resources"
              name="Drivers and Vehicles"
              parent="menu_setup"
              action="action_resource_management_dashboard"
              sequence="30"/>


    <!-- PROFESSIONAL BOOKING REPORTS -->

    <menuitem id="menu_report"
              name="Booking Reports"
              parent="menu_tour_root"
              action="action_booking_reports_dashboard"
              groups="tour_operator_booking.group_tour_manager"
              sequence="30"/>

</odoo>
