<odoo>
    <record id="view_cancel_booking_wizard_form" model="ir.ui.view">
        <field name="name">tour.operator.booking.cancel.wizard.form</field>
        <field name="model">tour.operator.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Booking">
                <group>
                    <field name="booking_id"/>
                    <field name="reason" placeholder="Enter the reason for cancelling this booking..."/>
                </group>
                <footer>
                    <button name="action_cancel_booking" type="object" string="Confirm Cancellation"
                            class="btn-primary"
                            confirm="Cancel this booking? Its reserved seats will be released and its voucher / QR code will become invalid."/>
                    <button string="Keep Booking" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
